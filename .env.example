PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/planeforge
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:7310
CORS_ALLOWED_ORIGINS=*
AUTH_TOKEN_TTL=3d
AUTH_SESSION_TTL_DAYS=3
LOGIN_CODE_TTL_MINUTES=10
RESET_CODE_TTL_MINUTES=10
ADMIN_SETUP_CODE=

# Third-party services
RESEND_API_KEY=
RESEND_FROM=PlaneForge <hello@planeforge.local>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Streaming provider. Large videos should be uploaded directly to the stream provider, never through the app server.
STREAM_PROVIDER=cloudflare
STREAM_TOKEN_TTL_SECONDS=300
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# Keep true for local development without real payment credentials.
MOCK_PAYMENTS=true
